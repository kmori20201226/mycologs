# Copy this file to .env and fill in the values.
# docker-compose.yml reads .env automatically from the project root.

# Required
ANTHROPIC_API_KEY=sk-ant-...
JWT_SECRET=change-me-to-a-random-secret

# Stripe (leave blank to disable payment features)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_CLUB=
NEXT_PUBLIC_STRIPE_PRICE_PERSONAL=
NEXT_PUBLIC_STRIPE_PRICE_CLUB=

# URL the browser uses to reach the API (baked into frontend at build time)
NEXT_PUBLIC_API_URL=http://localhost:3000

# URL the API uses to construct media URLs stored in the database (must be browser-reachable)
API_URL=http://localhost:3000

# Optional tuning
FREE_TIER_CREDITS=50
AI_IDENTIFICATION_COST=10
