server {
    listen 80;
    server_name sandbox-api.mycologs.club;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name sandbox-api.mycologs.club;

    ssl_certificate     /etc/letsencrypt/live/sandbox-api.mycologs.club/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sandbox-api.mycologs.club/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    location /webhook/stripe {
        proxy_pass         http://127.0.0.1:4000;
        proxy_http_version 1.1;

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        proxy_request_buffering off;
        proxy_buffering         off;
    }

    location / {
        proxy_pass         http://127.0.0.1:4000;
        proxy_http_version 1.1;

        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";

        client_max_body_size 55m;
    }
}
