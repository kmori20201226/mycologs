# Copy this file to .env and fill in the values.
# docker-compose.yml reads .env automatically from the project root.

# Required
ANTHROPIC_API_KEY=sk-ant-...
JWT_SECRET=change-me-to-a-random-secret

# Stripe (leave blank to disable payment features)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# LINE login (leave blank to disable LINE OAuth)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_CALLBACK_URL=http://localhost:3000/auth/line/callback
# LINE OAuth hosts — override only for testing; defaults are LINE's real endpoints
# LINE_AUTH_BASE=https://access.line.me
# LINE_API_BASE=https://api.line.me

# URL the browser uses to reach the API (baked into frontend at build time)
NEXT_PUBLIC_API_URL=http://localhost:3000

# URL the API uses to construct media URLs stored in the database (must be browser-reachable)
API_URL=http://localhost:3000

# Canonical URL of the web app — used for OAuth redirects, Stripe return URLs, email links
APP_URL=http://localhost:3001

# Comma-separated list of origins allowed by CORS (browser origins that may call the API)
CORS_ORIGINS=http://localhost:3001

# GSI address-search endpoint — override only for testing; default is GSI's real endpoint
# GSI_GEOCODE_URL=https://msearch.gsi.go.jp/address-search/AddressSearch

# Optional tuning
AI_IDENTIFICATION_COST=10

# Path to downloaded iNaturalist sample images (organized by taxon_id subdirectory)
INAT_IMAGES_DIR=/app/samples/iNaturalist-images
