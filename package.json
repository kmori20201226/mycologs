{
  "name": "mycologs",
  "version": "1.2.2",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm run build -ws",
    "start": "node apps/api/dist/server.js",
    "start:web": "cd apps/web && next start -p 3001",
    "start:ai": "cd ai-service && mycologs-ai-service --daemon",
    "stop:ai": "cd ai-service && mycologs-ai-service --stop",
    "db:up": "docker compose -f docker/postgres/docker-compose.yml up -d",
    "db:psql": "psql postgresql://postgres:password@localhost:5432/mycologs",
    "sandbox:psql": "cd test-sandbox && docker compose exec postgres psql -U postgres -d mycologs",
    "db:down": "docker compose -f docker/postgres/docker-compose.yml down",
    "migrate": "bash scripts/migrate.sh",
    "do-migrate": "npx prisma migrate dev",
    "prisma:gen": "npx prisma generate",
    "set-user-role": "npx ts-node scripts/set-user-role.ts",
    "add-user": "npx ts-node scripts/add-user.ts",
    "list-user": "npx ts-node scripts/list-user.ts",
    "seed-taxonomy": "npx ts-node scripts/seed-taxonomy.ts",
    "seed-admin-user": "npx ts-node scripts/seed-admin-user.ts",
    "seed-plans": "npx ts-node scripts/seed-plans.ts",
    "make-test-user": "npx ts-node scripts/make-test-user.ts",
    "test-line-push": "npx ts-node scripts/test-line-push.ts",
    "import-gbif-taxonomy": "npx ts-node scripts/import-gbif-taxonomy.ts",
    "backup-posts": "npx ts-node scripts/backup-posts.ts",
    "restore-posts": "npx ts-node scripts/restore-posts.ts",
    "test:users": "npx ts-node apps/api/test/users.test.ts",
    "test:clubs": "npx ts-node apps/api/test/clubs.test.ts",
    "test:roles": "npx ts-node apps/api/test/roles.test.ts",
    "test:oauth-accounts": "npx ts-node apps/api/test/oauth-accounts.test.ts",
    "test:shapes": "npx ts-node apps/api/test/shapes.test.ts",
    "test:families": "npx ts-node apps/api/test/families.test.ts",
    "test:genera": "npx ts-node apps/api/test/genera.test.ts",
    "test:species": "npx ts-node apps/api/test/species.test.ts",
    "test:events": "npx ts-node apps/api/test/events.test.ts",
    "test:posts": "npx ts-node apps/api/test/posts.test.ts",
    "test:followups": "npx ts-node apps/api/test/followups.test.ts",
    "test:identifications": "npx ts-node apps/api/test/identifications.test.ts",
    "test:votes": "npx ts-node apps/api/test/votes.test.ts",
    "test:media": "npx ts-node apps/api/test/media.test.ts",
    "test:auth-line": "npx ts-node apps/api/test/auth-line.test.ts",
    "test:admin-threads": "npx ts-node apps/api/test/admin-threads.test.ts",
    "test:ai-geocode": "npx ts-node apps/api/test/ai-geocode.test.ts",
    "test:ai-credit": "npx ts-node apps/api/test/ai-credit.test.ts",
    "test:ai-usage": "npx ts-node apps/api/test/ai-usage.test.ts",
    "test:posts-mentioned": "npx ts-node apps/api/test/posts-mentioned.test.ts",
    "test:posts-subscription": "npx ts-node apps/api/test/posts-subscription.test.ts",
    "test:ai-service": "cd ai-service && python3 -m pytest",
    "test": "npm run test:users && npm run test:clubs && npm run test:roles && npm run test:oauth-accounts && npm run test:shapes && npm run test:families && npm run test:genera && npm run test:species && npm run test:events && npm run test:posts && npm run test:followups && npm run test:identifications && npm run test:votes && npm run test:media && npm run test:auth-line && npm run test:admin-threads && npm run test:ai-geocode && npm run test:ai-credit && npm run test:ai-usage && npm run test:posts-mentioned && npm run test:posts-subscription"
  },
  "keywords": [],
  "author": "Kazuya Mori",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "prisma": "^7.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "dotenv": "^17.3.1",
    "pg": "^8.20.0"
  }
}
