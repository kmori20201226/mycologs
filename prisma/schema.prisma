// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClubStatus {
  PENDING
  ACTIVE
}

model Club {
  id            Int               @id @default(autoincrement())
  name          String
  introduction  String?
  policy        String?           // Club rules or guidelines displayed in separate page
  bannerImage   String?           @map("banner_image")
  status        ClubStatus        @default(ACTIVE)
  credit        Int               @default(0)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  deletedAt     DateTime?         @map("deleted_at")

  stripeCustomerId String?        @unique @map("stripe_customer_id")

  clubUsers     ClubUser[]
  events        Event[]
  userRequests  UserRequest[]
  subscriptions Subscription[]
  payments      Payment[]
  announcements Announcement[]
  postClubs     PostClub[]

  @@map("clubs")
}

enum RoleType {
  ADMIN
  DEVELOPER
  MODERATOR
  CLUBMEMBER
  CLUBMANAGER
}

// Role that can be assigned directly to a user (system-level).
// Club-membership roles (CLUBMEMBER, CLUBMANAGER) are intentionally excluded here —
// those are expressed via ClubUser, not on the user directly.
enum UserRole {
  ADMIN
  DEVELOPER
  MODERATOR
}

model Role {
  id            Int           @id @default(autoincrement())
  name          RoleType      @unique
  createdAt     DateTime      @default(now()) @map("created_at")

  clubUsers     ClubUser[]
  users         User[]

  @@map("roles")
}

model ClubUser {
  id            Int           @id @default(autoincrement())
  clubId        Int           @map("club_id")
  userId        Int           @map("user_id")
  roleId        Int           @map("role_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  club          Club          @relation(fields: [clubId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  role          Role          @relation(fields: [roleId], references: [id])

  @@unique([clubId, userId])
  @@map("club_users")
}

model User {
  id                Int               @id @default(autoincrement())
  name              String
  handleName        String?           @map("handle_name")
  email             String            @unique
  password_hash     String?
  emailVerified     DateTime?         @map("email_verified")
  address           String?
  tel               String?
  line_id           String?
  credit            Int               @default(0)
  meta              Json?
  role              UserRole?         @map("role")
  roleId            Int?              @map("role_id")
  voteWeight        Int?              @map("vote_weight")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")
  roleRef           Role?             @relation(fields: [roleId], references: [id])
  clubUsers         ClubUser[]
  oauthAccounts     OAuthAccount[]
  posts             Post[]
  identifications   Identification[]
  votes             Vote[]
  events            Event[]
  userRequests      UserRequest[]   @relation("UserRequestRequester")
  repliedRequests   UserRequest[]   @relation("UserRequestReplier")
  userLogs          UserLog[]       @relation("UserLogs")
  createdLogs       UserLog[]       @relation("CreatedLogs")
  stripeCustomerId        String?                  @unique @map("stripe_customer_id")
  subscriptions           Subscription[]
  payments                Payment[]
  emailVerificationCodes  EmailVerificationCode[]
  passwordResetCodes      PasswordResetCode[]
  adminThreads            AdminThread[]
  adminMessages           AdminMessage[]          @relation("AdminMessageSender")
  announcements           Announcement[]          @relation("AnnouncementAuthor")

  @@map("users")
}

// UserLog
// -----------------------------------------------------
// Intension:
//   In order to log users behavioral credibility so that the user is favorable
//   for this site. Unfavorable post is logged here. Points to be deduct is defined as follows:
//    -5 Offensive, sexual post that should not be shown. (This rule is applied to images posted)
//    -2 Someone may feel offensive, arrogant: this post is going to be shown.
//    -1 Images posted are not related mushrooms, ambient.
//   Evaluation is made by AI agent.
//   If point is below a threashold within certain period of time, any post actions are not allowed.
// Column descriptions:
//   transactionType: for now, "POST" for user post, "RESET" for administrator reset of points.
//       "RESET" is a special record which an administrator adds.
//   userPost: User post which is rejected.
//   comment: Text how the AI agent judged

enum SubscriptionStatus {
  trialing
  active
  past_due
  unpaid
  canceled
  inactive
}

enum PaymentStatus {
  paid
  failed
  refunded
}

model Subscription {
  id                     String              @id @default(uuid())
  userId                 Int?                @map("user_id")
  user                   User?               @relation(fields: [userId], references: [id])
  clubId                 Int?                @map("club_id")
  club                   Club?               @relation(fields: [clubId], references: [id])

  status                 SubscriptionStatus

  planId                 String              @map("plan_id")

  currentPeriodStart     DateTime?           @map("current_period_start")
  currentPeriodEnd       DateTime?           @map("current_period_end")

  cancelAtPeriodEnd      Boolean             @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime?           @map("canceled_at")

  trialStart             DateTime?           @map("trial_start")
  trialEnd               DateTime?           @map("trial_end")

  // Optimization for fast access checks
  accessUntil            DateTime?           @map("access_until")

  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  payments               Payment[]

  @@index([userId])
  @@index([clubId])
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id               String         @id @default(uuid())

  userId           Int?           @map("user_id")
  clubId           Int?           @map("club_id")
  user             User?          @relation(fields: [userId], references: [id])
  club             Club?          @relation(fields: [clubId], references: [id])

  subscriptionId   String?        @map("subscription_id")
  subscription     Subscription?  @relation(fields: [subscriptionId], references: [id])

  amount           Int            // smallest currency unit (e.g. yen)
  currency         String

  status           PaymentStatus

  provider         String         // e.g. "stripe"
  providerRef      String?        @map("provider_ref")

  paidAt           DateTime?      @map("paid_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([userId])
  @@index([clubId])
  @@index([subscriptionId])
  @@index([provider, providerRef])
  @@map("payments")
}

enum TransactionType {
  POST
  UPDATE
  DELETE
  RESET
}

enum RejectionCategory {
  OFFENSIVE_SEXUAL
  POTENTIALLY_OFFENSIVE
  OFF_TOPIC_IMAGE
  NONE
}

model UserLog {
  id                 Int                @id @default(autoincrement())
  userId             Int                @map("user_id")
  user               User               @relation("UserLogs", fields: [userId], references: [id])
  postId             Int?               @map("post_id")
  point              Int                @default(0)
  transactionType    TransactionType    @map("transaction_type")
  rejectionCategory  RejectionCategory? @map("rejection_category")
  userPost           String             @map("user_post")
  comment            String
  createdBy          Int                @map("created_by")
  creator            User               @relation("CreatedLogs", fields: [createdBy], references: [id])
  createdAt          DateTime           @default(now()) @map("created_at")

  @@map("user_log")
  @@index([userId, createdAt])
}

model UserRequest {
  id                Int       @id @default(autoincrement())
  requesterId       Int       @map("requester_id")
  clubId            Int?      @map("club_id")
  request           Json?
  reply             Json?
  replierId         Int?      @map("replier_id")
  accepted          Boolean?
  createdAt         DateTime  @default(now()) @map("created_at")
  repliedAt         DateTime? @map("replied_at")

  requester         User      @relation("UserRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  replier           User?     @relation("UserRequestReplier", fields: [replierId], references: [id], onDelete: SetNull)
  club              Club?     @relation(fields: [clubId], references: [id], onDelete: SetNull)

  @@map("user_requests")
}

model OAuthAccount {
  id                String    @id @default(cuid())
  userId            Int       @map("user_id")
  provider          String    // "google", "github", "discord", etc.
  providerAccountId String    @map("provider_account_id") // ID from the provider
  accessToken       String?   @db.Text @map("access_token")
  refreshToken      String?   @db.Text @map("refresh_token")
  expiresAt         Int?      @map("expires_at") // Unix timestamp
  tokenType         String?   @map("token_type")
  scope             String?   // Space-separated permissions
  idToken           String?   @db.Text @map("id_token")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

enum PublicityType {
  PUBLIC
  CLUBMEMBERONLY
  PRIVATE
}

model Event {
  id                Int        @id @default(autoincrement())
  clubId            Int?       @map("club_id")
  userId            Int?       @map("user_id")
  name              String
  description       String?
  place             String?
  // A coarse, deliberately public-safe location label (e.g. "高尾山周辺"). Unlike
  // `place` (precise, used for geocoding), this is meant to be shown publicly on
  // posts linked to the event. Null = nothing shown.
  publicPlace       String?    @map("public_place")
  longitude         Float?
  latitude          Float?
  startAt           DateTime?  @map("start_at")
  endAt             DateTime?  @map("end_at")
  bannerImage       String?    @map("banner_image")
  retrospective     String?
  createdAt         DateTime   @default(now()) @map("created_at")

  club              Club?      @relation(fields: [clubId], references: [id])
  user              User?      @relation(fields: [userId], references: [id])
  posts             Post[]

  @@map("events")
}

model Post {
  id                 Int           @id @default(autoincrement())
  eventId            Int?          @map("event_id")
  userId             Int           @map("user_id")
  parentPostId       Int?          @map("parent_post_id")
  contents           String
  visibility         PublicityType @default(PUBLIC) @map("visibility")
  // Where the photo was taken (from the first uploaded image's EXIF GPS, or the
  // device's geolocation as a fallback). takenAt is the photo's EXIF capture time,
  // used to match the post to an overlapping Event. All null when no location is known.
  longitude          Float?        @map("longitude")
  latitude           Float?        @map("latitude")
  takenAt            DateTime?     @map("taken_at")
  // Number of images the author is uploading (set at create time). The post is
  // "media-complete" once its IMAGE media count reaches this. 0 = nothing
  // pending (backward compatible with posts created before background uploads).
  expectedMediaCount Int           @default(0) @map("expected_media_count")
  deletedAt          DateTime?     @map("deleted_at")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event             Event?    @relation(fields: [eventId], references: [id])
  parent            Post?     @relation("PostReplies", fields: [parentPostId], references: [id])
  replies           Post[]    @relation("PostReplies")
  identifications   Identification[]
  votes             Vote[]
  media             Media[]
  postClubs         PostClub[]

  @@map("posts")
}

model PostClub {
  id      Int   @id @default(autoincrement())
  postId  Int   @map("post_id")
  clubId  Int   @map("club_id")

  post    Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  club    Club  @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([postId, clubId])
  @@map("post_clubs")
}

model Identification {
  id                Int       @id @default(autoincrement())
  postId            Int       @map("post_id")
  userId            Int       @map("user_id")
  identificationHint String?   @map("identification_hint")
  specieId          Int?      @map("specie_id")
  description       Json?     @map("description")
  accepted          Boolean   @default(false) @map("accepted")
  confidence        Float?    // Calculated at query time
  score             Float?    // AI inference score
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post              Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  species           Species?  @relation(fields: [specieId], references: [id], onDelete: SetNull)
  votes             Vote[]

  @@map("identifications")
}

model Vote {
  id                Int       @id @default(autoincrement())
  postId            Int       @map("post_id")
  userId            Int       @map("user_id")
  identificationId  Int       @map("identification_id")
  probability       Float
  createdAt         DateTime  @default(now()) @map("created_at")

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post              Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  identification    Identification @relation(fields: [identificationId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("votes")
}

model Species {
  id                Int        @id @default(autoincrement())
  genusId           Int        @map("genus_id")
  scientificName    String     @unique @map("scientific_name")
  japaneseName      String?    @map("japanese_name")
  gbifTaxonKey      Int?       @unique @map("gbif_taxon_key")
  edibility         Edibility?
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  deletedAt         DateTime?  @map("deleted_at") // Soft delete

  genus             Genus      @relation(fields: [genusId], references: [id], onDelete: Cascade)
  identifications   Identification[]
  aliases           SpeciesAlias[]

  @@map("species")
}

// Japanese name synonyms for a species, used to resolve a vernacular name
// mentioned in a post back to its canonical species (extractMentionedSpecies).
// Populated from the gbif extract-synonyms CSV (sources: db, wikipedia, inat).
// `name` is globally unique: ambiguity (one name -> many species) is resolved
// at import time by source priority + occurrence_score, so a match maps to a
// single canonical species.
model SpeciesAlias {
  id          Int      @id @default(autoincrement())
  speciesId   Int      @map("species_id")
  name        String   @unique
  source      String
  createdAt   DateTime @default(now()) @map("created_at")

  species     Species  @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@index([speciesId])
  @@map("species_aliases")
}

model Genus {
  id                Int       @id @default(autoincrement())
  familyId          Int       @map("family_id")
  scientificName    String    @unique @map("scientific_name")
  japaneseName      String?   @map("japanese_name")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  family            Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  species           Species[]

  @@map("genera")
}

model Family {
  id                Int       @id @default(autoincrement())
  scientificName    String    @unique @map("scientific_name")
  japaneseName      String?   @map("japanese_name")
  shapeId           Int       @map("shape_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  shape             Shape     @relation(fields: [shapeId], references: [id], onDelete: Cascade)
  genera            Genus[]

  @@map("families")
}

enum Edibility {
  EDIBLE
  INEDIBLE
  TOXIC
  DEADLY
  UNKNOWN
}

model Shape {
  id                Int       @id @default(autoincrement())
  name              String    @unique
  japaneseName      String?   @map("japanese_name")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  families          Family[]

  @@map("shapes")
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

model Media {
  id            String    @id @default(cuid())
  filename      String
  originalName  String    // Original filename uploaded by user
  url           String    // S3, Cloud Storage, or CDN URL
  type          MediaType
  mimeType      String    // image/jpeg, video/mp4, etc.
  
  // File metadata
  size          Int       // File size in bytes
  duration      Int?      // Duration in seconds (for video/audio)
  width         Int?      // Image/video width in pixels
  height        Int?      // Image/video height in pixels
  
  // Relationships
  postId        Int       @map("post_id")
  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  // Thumbnail/preview for videos
  thumbnailUrl  String?   @map("thumbnail_url")
  
  // Metadata
  isPublic      Boolean   @default(false) @map("is_public")
  description   String?
  tags          String[]  // Array of tags for search
  
  // Timestamps
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at") // Soft delete
  
  @@map("media")
}

enum AdminThreadStatus {
  OPEN
  CLOSED
}

model AdminThread {
  id          Int               @id @default(autoincrement())
  userId      Int               @map("user_id")
  subject     String
  status      AdminThreadStatus @default(OPEN)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AdminMessage[]

  @@map("admin_threads")
}

model AdminMessage {
  id          Int          @id @default(autoincrement())
  threadId    Int          @map("thread_id")
  senderId    Int          @map("sender_id")
  body        String
  readAt      DateTime?    @map("read_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  thread      AdminThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender      User         @relation("AdminMessageSender", fields: [senderId], references: [id])

  @@map("admin_messages")
}

model EmailVerificationCode {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  code      String
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_codes")
}

model PasswordResetCode {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  code      String
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_codes")
}

model Plan {
  id                String   @id
  name              String
  maxMembers        Int      @map("max_members")
  priceYen          Int      @map("price_yen")
  creditsPerPeriod  Int      @default(0) @map("credits_per_period")
  active            Boolean  @default(true)
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("plans")
}

model Announcement {
  id        Int      @id @default(autoincrement())
  body      String
  authorId  Int      @map("author_id")
  clubId    Int?     @map("club_id")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  author    User  @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  club      Club? @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@map("announcements")
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

// One row per Anthropic API call the platform makes (identification, post
// moderation, geocoding). Token counts come from the model's `usage` object;
// costMicroUsd is computed at write time from a per-model rate table.
// postId/userId/clubId are plain ints (no FK relations) so this stays an
// append-only cost ledger that survives deletion of the referenced rows.
model AiUsageLog {
  id                  Int      @id @default(autoincrement())
  kind                String   // "identify" | "moderate" | "geocode"
  model               String   // anthropic model id that served the call
  inputTokens         Int      @map("input_tokens")
  outputTokens        Int      @map("output_tokens")
  cacheCreationTokens Int      @default(0) @map("cache_creation_tokens")
  cacheReadTokens     Int      @default(0) @map("cache_read_tokens")
  costMicroUsd        Int      @map("cost_micro_usd") // integer micro-USD (1e-6 USD); no float drift
  postId              Int?     @map("post_id")
  userId              Int?     @map("user_id")
  clubId              Int?     @map("club_id")
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([clubId, createdAt])
  @@index([userId, createdAt])
  @@map("ai_usage_log")
}